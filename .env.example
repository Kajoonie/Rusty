# Required for basic bot functionality
DISCORD_TOKEN=your-discord-api-key

DEFAULT_OLLAMA_MODEL=default-ollama-model-name

# Optional API keys based on enabled features
# Required unless the "brave_search" feature flag is disabled
BRAVE_API_KEY=your-brave-search-api-key

# Required for the 'autoplay' functionality of the 'music' feature
SERP_API_KEY=your-serp-api-key

# Required for the 'spotify' functionality of the 'music' feature
SPOTIFY_CLIENT_ID=your_client_id
SPOTIFY_CLIENT_SECRET=your_client_secret

# Optional, for the '/say' command of the 'tts' feature
# Path to the DECtalk 'say' executable (default: /opt/dectalk/say)
DECTALK_PATH=/opt/dectalk/say
# User DECtalk runs as when the bot runs as root (default: nobody)
DECTALK_RUN_AS=nobody

# Optional, for the '/ask' command of the 'tts' feature
# Anthropic API key; without it '/ask' replies that the key is not set
ANTHROPIC_API_KEY=your-anthropic-api-key
# Claude model that answers '/ask' (default: claude-opus-5-5)
ANTHROPIC_MODEL=claude-opus-5-5

# To enable only specific features during build:
# cargo build --no-default-features --features "brave_search"
# cargo build --no-default-features --features "music"
# cargo build --no-default-features --features "brave_search music"